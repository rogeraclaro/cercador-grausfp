ADMIN_TOKEN=canvia-aquest-token-per-un-de-segur

# Brevo — notificacions de novetats (opcional; si buides, no s'envien emails)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cercador FP España

# Brevo SMTP — autenticació d'usuaris (verificació email, reset contrasenya)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=roger@masellas.info
BREVO_SMTP_KEY=

# Email remitent
EMAIL_FROM=noreply@masellas.info
EMAIL_FROM_NAME=Cercador FP España

# URL base per als links dels emails (sense trailing slash)
BASE_URL=https://domini.com

# Clau secreta (reservada per a futures necessitats de CSRF)
# Genera amb: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=canvia-aquest-valor-per-un-de-segur

# Base de dades SQLite (opcional — per defecte: backend/data/fp_cercador.db)
# DB_PATH=/ruta/alternativa/fp_cercador.db

URL_GRADO_D_BASICO=https://www.todofp.es/que-estudiar/grados-d/fp-grado-basico.html
URL_GRADO_D_MEDIO=https://www.todofp.es/que-estudiar/grados-d/grado-medio.html
URL_GRADO_D_SUPERIOR=https://www.todofp.es/que-estudiar/grados-d/grado-superior.html
URL_GRADO_E=https://www.todofp.es/que-estudiar/grados-e/curso-especializacion.html
