[Unit]
Description=Cercador FP España — Flask backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/masellas-grausfp/htdocs/grausfp.masellas.info/fp-cercador/backend
Environment="PATH=/home/masellas-grausfp/htdocs/grausfp.masellas.info/venv/bin"
EnvironmentFile=/home/masellas-grausfp/htdocs/grausfp.masellas.info/fp-cercador/backend/.env
ExecStart=/home/masellas-grausfp/htdocs/grausfp.masellas.info/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8033 \
    --timeout 120 \
    --access-logfile /var/log/fp-cercador/access.log \
    --error-logfile /var/log/fp-cercador/error.log \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
